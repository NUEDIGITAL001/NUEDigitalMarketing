{
  // Cloudflare Workers config. `npx wrangler deploy` uploads out/ (the static
  // export made by `npm run build`) plus the form handler in worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuedigitalmarketing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; pages are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
